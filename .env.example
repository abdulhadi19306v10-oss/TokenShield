# TokenShield Proxy Configuration
HOST=0.0.0.0
PORT=8000
UPSTREAM_BASE_URL=https://api.openai.com/v1
UPSTREAM_API_KEY=
DEFAULT_MODEL=gpt-4o-mini

# Pre-Execution Thresholds
MAX_TOOL_PAYLOAD_BYTES=4096
SLIDING_WINDOW_TURNS=10
ENABLE_DEDUPLICATION=true

# In-Flight Streaming & Anomaly Thresholds
NGRAM_N=3
NGRAM_WINDOW_TOKENS=40
LOOP_ANOMALY_THRESHOLD=0.70
SIMILARITY_THRESHOLD=0.85
MIN_TOKENS_BEFORE_CHECK=15

# Telemetry & Database
DATABASE_PATH=tokenshield_telemetry.db

# Circuit Breaker Policies
ENABLE_HUMAN_CHECKPOINT=false
AUTO_INJECT_STEERING=true
